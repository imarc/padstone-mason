<div
    class="padstone-mason"
    data-assistant-root
    data-conversation-id="{{ conversation.id ?? '' }}"
    data-scope="{{ scope }}"
    {% if entryId %}data-entry-id="{{ entryId }}"{% endif %}
    {% if siteId %}data-site-id="{{ siteId }}"{% endif %}
    {% if previewUrl %}data-preview-url="{{ previewUrl }}"{% endif %}
    {% if editUrl %}data-edit-url="{{ editUrl }}"{% endif %}
    {% if boundTitle %}data-bound-title="{{ boundTitle|e('html_attr') }}"{% endif %}
    {% if boundIsDraft %}data-bound-draft="1"{% endif %}
    {% if boundDraftId %}data-bound-draft-id="{{ boundDraftId }}"{% endif %}
>
    <div class="padstone-mason__layout">
        <aside class="padstone-mason__list" aria-label="Chats">
            <button type="button" class="btn" data-assistant-new>New chat</button>
            <ul class="padstone-mason__conversations" data-assistant-conversations>
                {% for item in conversations %}
                    <li>
                        <button type="button" data-assistant-select data-conversation-id="{{ item.id }}"{% if conversation and item.id == conversation.id %} aria-current="true"{% endif %}>{{ item.title }}</button>
                    </li>
                {% endfor %}
            </ul>
        </aside>

        <div class="padstone-mason__chat">
            <div class="padstone-mason__chat-intro">
                <div class="padstone-mason__bound" data-assistant-bound{% if not boundTitle %} data-empty="true"{% endif %}>
                    <span class="padstone-mason__bound-label">{% if boundTitle %}Bound page{% else %}No page bound{% endif %}</span>
                    {% if boundTitle %}
                        {% if editUrl %}
                            <a class="padstone-mason__bound-title" data-assistant-bound-title href="{{ editUrl }}">{{ boundTitle }}</a>
                        {% else %}
                            <span class="padstone-mason__bound-title" data-assistant-bound-title>{{ boundTitle }}</span>
                        {% endif %}
                        <span class="padstone-mason__bound-state" data-assistant-bound-state{% if not boundIsDraft %} hidden{% endif %}>Draft</span>
                    {% else %}
                        <span class="padstone-mason__bound-title" data-assistant-bound-title hidden></span>
                        <span class="padstone-mason__bound-state" data-assistant-bound-state hidden>Draft</span>
                    {% endif %}
                </div>
                <header class="padstone-mason__subject" data-assistant-subject-wrap{% if not conversation %} hidden{% endif %}>
                    <h2 class="padstone-mason__subject-line">
                        <span data-assistant-subject>{{ conversation.title ?? 'New chat' }}</span>
                        <button type="button" class="btn chromeless small padstone-mason__subject-edit" data-assistant-edit-subject data-icon="edit" aria-label="Edit subject"></button>
                        <button type="button" class="btn chromeless small padstone-mason__subject-delete" data-assistant-delete data-icon="trash" aria-label="Delete chat"{% if not conversation %} hidden{% endif %}></button>
                    </h2>
                </header>
                <p class="padstone-mason__note">{{ draftNote }}</p>
            </div>

            <div class="padstone-mason__transcript" data-assistant-transcript>
                {% for message in messages %}
                    <article class="padstone-mason__message padstone-mason__message--{{ message.role }}" data-role="{{ message.role }}">
                        {% if message.content %}{{ message.content|markdown('gfm') }}{% endif %}
                        {% if message.assets is defined and message.assets %}
                            <div class="padstone-mason__message-assets">
                                {% for asset in message.assets %}
                                    <figure class="padstone-mason__thumb">
                                        {% if asset.thumbUrl %}
                                            <img src="{{ asset.thumbUrl }}" alt="{{ asset.title|e('html_attr') }}" width="64" height="64">
                                        {% endif %}
                                        <figcaption>#{{ asset.id }} {{ asset.filename }}</figcaption>
                                    </figure>
                                {% endfor %}
                            </div>
                        {% endif %}
                        {% if message.role == 'assistant' and message.tools is defined and message.tools %}
                            <footer class="padstone-mason__message-tools">Tools used: {{ message.tools|join(', ') }}</footer>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>

            {# Div, not form: CpScreenSlideout is already a <form>, and nested forms are ignored by the browser. #}
            <div class="padstone-mason__form" data-assistant-form>
                <input type="hidden" name="conversationId" value="{{ conversation.id ?? '' }}">
                <textarea name="message" rows="4" placeholder="Describe the page change, or paste an image URL"></textarea>
                <div class="padstone-mason__attachments" data-assistant-attachments hidden></div>
                <div class="padstone-mason__actions">
                    <button type="button" class="btn" data-assistant-attach>Attach image</button>
                    <input type="file" name="images[]" accept="image/*" multiple hidden data-assistant-file>
                    <button type="button" class="btn submit" data-assistant-send>Send</button>
                    <span class="padstone-mason__hint">Enter to send, Shift+Enter or ⌘+Enter for a new line</span>
                    <button type="button" class="btn" data-assistant-publish>Publish draft</button>
                    <button type="button" class="btn" data-assistant-preview-toggle {% if not previewUrl %}hidden{% endif %} aria-expanded="false">Preview</button>
                </div>
            </div>
        </div>
    </div>

    <div class="padstone-mason__subject-modal" data-assistant-subject-modal hidden>
        <div class="padstone-mason__subject-modal-backdrop" data-assistant-subject-cancel></div>
        <div class="padstone-mason__subject-dialog" role="dialog" aria-modal="true" aria-labelledby="padstone-mason-subject-heading">
            <h2 id="padstone-mason-subject-heading" class="padstone-mason__subject-dialog-heading">Edit subject</h2>
            <label class="field">
                <span class="visually-hidden">Subject</span>
                <input type="text" class="text fullwidth" data-assistant-subject-input maxlength="80" autocomplete="off">
            </label>
            <p class="padstone-mason__subject-error" data-assistant-subject-error hidden></p>
            <div class="btngroup">
                <button type="button" class="btn submit" data-assistant-subject-save>Save</button>
                <button type="button" class="btn" data-assistant-subject-cancel>Cancel</button>
            </div>
        </div>
    </div>
</div>
